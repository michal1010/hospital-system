@using System.Globalization;
@using ClinicApp.Data;
@model IEnumerable<ClinicApp.Models.Appointment>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Appointments</h1>

<p>
    <a asp-action="CreateShift">Create New</a>
</p>
@{
    int currentWeekNumber = ViewBag.CurrentWeekNumber;
    var AppointmentsForCurrentWeek = Model
        .Where(item => CultureInfo.CurrentCulture.Calendar.GetWeekOfYear(item.StartTime, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday) == currentWeekNumber)
        .OrderBy(item => item.StartTime)
        .ToList();

    var groupedAppointments = AppointmentsForCurrentWeek.GroupBy(item => CultureInfo.CurrentCulture.Calendar.GetWeekOfYear(item.StartTime, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday));
}
@foreach(var group in groupedAppointments)
{
    <table class="table">
        <thead>
            <tr>
                <th>@(ViewBag.StartWeek) - @(ViewBag.EndWeek)</th>
               
            </tr>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Doctor.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Doctor.Surname)
                </th>
                <th>
                    @Html.DisplayNameFor(model=> model.Doctor.Sepcialization)
                </th>
                <th>
                    @Html.DisplayNameFor(model=> model.StartTime)

                </th>
                <th>
                    End time
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in group)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Doctor.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Doctor.Surname)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Doctor.Sepcialization)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.StartTime)
                    </td>
                    <td>
                        @item.StartTime.AddMinutes(Constants.MINUTES_VISIT).ToString(Constants.DATE_FORMAT)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

}

<div>
    <a asp-action="DecreaseNumberWeeks" >Previous Week</a>
    |
    <a asp-action="IncreaseNumberWeeks" >Next Week</a>
</div>
<div>
    <a asp-action="CopyPreviosWeek">Copy this week</a>
</div>
<p>
    <a href="@Url.Action("Index", "Director")">Back</a>
</p>